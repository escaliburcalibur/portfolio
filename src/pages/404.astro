---
import Shell from '@layouts/Shell.astro';
import { withBase } from '@lib/url';
import type { PageSeo } from '@lib/seo';

const seo: PageSeo = {
  title: 'Página no encontrada',
  description:
    'Esta página no existe o se ha movido. Vuelve al inicio o explora los proyectos.',
  path: '/404',
  noindex: true,
};
---

<Shell {...seo}>
  <h1 class="page-title" data-fx data-reveal-text>404</h1>
  <p class="notfound__text" data-reveal>Esta página no existe.</p>
  <nav class="notfound__nav" aria-label="Recuperación">
    <a class="btn-text" href={withBase('/')} data-fx>Volver al inicio</a>
    <a class="btn-text" href={withBase('/proyectos')} data-fx>Ver proyectos</a>
  </nav>

  <style>
    .notfound__text {
      margin-block-start: var(--space-sm);
      color: var(--color-fg-70);
    }
    .notfound__nav {
      display: flex;
      gap: var(--space-md);
      margin-block-start: var(--space-md);
    }
  </style>
</Shell>
