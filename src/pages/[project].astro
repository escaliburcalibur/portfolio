---
import { render } from 'astro:content';
import Shell from '@layouts/Shell.astro';
import SliceMedia from '@components/project/SliceMedia.astro';
import SliceText from '@components/project/SliceText.astro';
import SliceGallery from '@components/project/SliceGallery.astro';
import ProjectInfo from '@components/project/ProjectInfo.astro';
import { getProjects } from '@lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { project: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const d = project.data;
const seo = {
  title: d.seo?.metaTitle ?? d.title,
  description:
    d.seo?.metaDescription ??
    `${d.title} — ${d.railDescription}. ${d.client}, ${d.year}.`,
  path: `/${project.id}`,
  ogImage: d.seo?.ogImage ?? d.cover,
  type: 'article',
};
---

<Shell {...seo}>
  <main id="main" class="project">
    <div class="project__stream">
      {
        d.slices.map((slice) => {
          if (slice.type === 'media')
            return (
              <SliceMedia
                src={slice.src}
                ratio={slice.ratio}
                orientation={slice.orientation}
                caption={slice.caption}
              />
            );
          if (slice.type === 'gallery')
            return (
              <SliceGallery
                items={slice.items}
                count={slice.count}
                ratio={slice.ratio}
              />
            );
          return (
            <SliceText
              heading={slice.heading}
              body={slice.body}
              variant={slice.variant}
            />
          );
        })
      }
    </div>

    <div class="project__info">
      <ProjectInfo project={project}>
        <Content />
      </ProjectInfo>
    </div>
  </main>
</Shell>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .project__stream {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
</style>
