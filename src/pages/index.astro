---
import Shell from '@layouts/Shell.astro';
import HeroSwap from '@components/home/HeroSwap.astro';
import UpdatesGrid from '@components/home/UpdatesGrid.astro';
import { SITE } from '@lib/seo';

const seo = {
  title: SITE.name,
  description:
    'David Bayón — independent design studio. Branding, brand strategy, motion, 3D, web design, UI/UX and creative development.',
  path: '/',
};
---

<Shell {...seo}>
  <main id="main" class="home">
    <HeroSwap />
    <UpdatesGrid />
  </main>
</Shell>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl);
  }
</style>
