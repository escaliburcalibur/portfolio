---
import Shell from '@layouts/Shell.astro';
import HeroSwap from '@components/home/HeroSwap.astro';
import UpdatesGrid from '@components/home/UpdatesGrid.astro';
import { SITE, checkDescription, type PageSeo } from '@lib/seo';

const seo: PageSeo = {
  title: SITE.name,
  description: checkDescription(SITE.description, 'index'),
  path: '/',
  type: 'website',
};
---

<Shell {...seo}>
  <h1 class="sr-only">David Bayón — Estudio de diseño</h1>
  <HeroSwap />
  <UpdatesGrid />
</Shell>
