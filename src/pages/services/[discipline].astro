---
import Shell from '@layouts/Shell.astro';
import WorkCard from '@components/work/WorkCard.astro';
import {
  getDisciplines,
  getProjectsByDiscipline,
  getTestimonialsByDiscipline,
  type Discipline,
} from '@lib/content';

export async function getStaticPaths() {
  const disciplines = await getDisciplines();
  return disciplines.map((entry) => ({
    params: { discipline: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const slug = entry.id as Discipline;
const projects = await getProjectsByDiscipline(slug);
const testimonials = await getTestimonialsByDiscipline(slug);

const seo = {
  title: d.seo?.metaTitle ?? `${d.name} — David Bayón`,
  description: d.seo?.metaDescription ?? d.pitch,
  path: `/services/${entry.id}`,
};
---

<Shell {...seo}>
  <main id="main" class="service">
    <header class="service__head">
      <p class="service__eyebrow">Services</p>
      <h1 class="service__title">{d.name}</h1>
      <p class="service__hero">{d.hero}</p>
      <p class="service__pitch">{d.pitch}</p>
    </header>

    {
      projects.length > 0 && (
        <section class="service__block" aria-label={`${d.name} work`}>
          <h2 class="service__block-title">Selected work</h2>
          <div class="service__grid">
            {projects.map((project) => (
              <WorkCard project={project} />
            ))}
          </div>
        </section>
      )
    }

    {
      d.faq.length > 0 && (
        <section class="service__block" aria-label="Frequently asked">
          <h2 class="service__block-title">Questions</h2>
          <dl class="service__faq">
            {d.faq.map((item) => (
              <div>
                <dt>{item.q}</dt>
                <dd>{item.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      testimonials.length > 0 && (
        <section class="service__block" aria-label="What clients say">
          <ul class="service__quotes">
            {testimonials.map((t) => (
              <li>
                <p>{t.data.quote}</p>
                <p class="service__cite">
                  {t.data.author}, {t.data.role} — {t.data.company}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <a class="service__cta" href={`/all?filter=${entry.id}`}>
      See all {d.name} work
    </a>
  </main>
</Shell>

<style>
  .service {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .service__head {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xs);
    inline-size: min(100%, 60ch);
  }

  .service__eyebrow {
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-content-faint);
  }

  .service__title {
    font-size: var(--text-display-lg);
  }

  .service__hero {
    font-size: var(--text-body);
  }

  .service__pitch {
    font-size: var(--text-small);
    color: var(--color-content-muted);
  }

  .service__block-title {
    font-size: var(--text-display);
    color: var(--color-content-muted);
    margin-block-end: var(--spacing-sm);
  }

  .service__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--spacing-md) var(--spacing-sm);
  }

  .service__faq {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .service__faq dt {
    font-size: var(--text-small);
    color: var(--color-content);
    margin-block-end: var(--spacing-3xs);
  }

  .service__faq dd {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-content-muted);
  }

  .service__quotes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    font-size: var(--text-body);
  }

  .service__cite {
    margin-block-start: var(--spacing-3xs);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-content-faint);
  }

  .service__cta {
    align-self: start;
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-content);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 2px;
  }
</style>
