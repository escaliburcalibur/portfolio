---
import { getEntry, render } from 'astro:content';
import Shell from '@layouts/Shell.astro';
import Placeholder from '@components/Placeholder.astro';
import { getDisciplines, getSettings, getTestimonials } from '@lib/content';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing content/pages/about.md');
const { Content } = await render(page);

const disciplines = await getDisciplines();
const settings = await getSettings();
const testimonials = await getTestimonials();

const seo = {
  title: page.data.seo?.metaTitle ?? page.data.title,
  description: page.data.seo?.metaDescription ?? page.data.description,
  path: '/about',
};
---

<Shell {...seo}>
  <main id="main" class="about">
    <div class="about__body">
      <h1 class="about__title" data-text-fx data-text-reveal>About</h1>
      <div class="about__prose"><Content /></div>

      <section class="about__block" aria-label="Services">
        <h2 class="about__block-title">Services</h2>
        <ul class="about__services">
          {
            disciplines.map((d) => (
              <li>
                <a href={`/services/${d.id}`}>{d.data.name}</a>
                <span>{d.data.hero}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        testimonials.length > 0 && (
          <section class="about__block" aria-label="What clients say">
            <h2 class="about__block-title">Words</h2>
            <ul class="about__quotes">
              {testimonials.map((t) => (
                <li>
                  <p class="about__quote">{t.data.quote}</p>
                  <p class="about__cite">
                    {t.data.author}, {t.data.role} — {t.data.company}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <aside class="about__rail">
      <Placeholder label="Portrait" ratio="4 / 5" />
      {
        settings?.location && (
          <p class="about__meta">
            <span>Based in</span> {settings.location}
          </p>
        )
      }
      {
        settings?.availability && (
          <p class="about__meta">
            <span>Status</span> {settings.availability}
          </p>
        )
      }
      {
        settings?.email && (
          <p class="about__meta">
            <span>Contact</span>
            <a href={`mailto:${settings.email}`}>{settings.email}</a>
          </p>
        )
      }
      {
        settings && settings.clients.length > 0 && (
          <div class="about__meta">
            <span>Selected clients</span>
            <ul>
              {settings.clients.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </div>
        )
      }
      {
        settings && settings.socials.length > 0 && (
          <ul class="about__socials">
            {settings.socials.map((s) => (
              <li>
                <a href={s.href}>{s.label}</a>
              </li>
            ))}
          </ul>
        )
      }
    </aside>
  </main>
</Shell>

<style>
  .about {
    display: grid;
    gap: var(--spacing-xl);
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .about__title {
    font-size: var(--text-display);
  }

  .about__prose {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    font-size: var(--text-body);
  }

  .about__block-title {
    font-size: var(--text-display);
    color: var(--color-content-muted);
    margin-block-end: var(--spacing-sm);
  }

  .about__services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xs);
  }

  .about__services li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2xs) var(--spacing-sm);
    align-items: baseline;
  }

  .about__services a {
    font-size: var(--text-small);
    color: var(--color-content);
    border-bottom: 1px solid var(--color-line);
  }

  .about__services span {
    font-size: var(--text-meta);
    color: var(--color-content-faint);
  }

  .about__quotes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .about__quote {
    font-size: var(--text-body);
  }

  .about__cite {
    margin-block-start: var(--spacing-3xs);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-content-faint);
  }

  .about__rail {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    font-size: var(--text-small);
    color: var(--color-content-muted);
  }

  .about__meta span {
    display: block;
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-content-faint);
    margin-block-end: var(--spacing-3xs);
  }

  .about__meta ul,
  .about__socials {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about__socials a {
    border-bottom: 1px solid var(--color-line);
  }

  @media (min-width: 57rem) {
    .about {
      grid-template-columns: 1.6fr 1fr;
      gap: var(--spacing-2xl);
      align-items: start;
    }

    .about__rail {
      position: sticky;
      inset-block-start: var(--spacing-lg);
    }
  }
</style>
