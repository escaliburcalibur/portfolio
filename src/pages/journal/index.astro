---
import Shell from '@layouts/Shell.astro';
import UpdateCard from '@components/home/UpdateCard.astro';
import { getJournal } from '@lib/content';

const journal = await getJournal();

const seo = {
  title: 'Journal',
  description:
    'Studio updates from David Bayón — launches, notes, talks and news.',
  path: '/journal',
};
---

<Shell {...seo}>
  <main id="main" class="journal">
    <h1 class="journal__title">Journal</h1>
    <div class="journal__grid">
      {
        journal.map((entry, i) => (
          <UpdateCard entry={entry} withMedia={i % 3 === 1} />
        ))
      }
    </div>
  </main>
</Shell>

<style>
  .journal {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .journal__title {
    font-size: var(--text-display);
  }

  .journal__grid {
    column-count: 1;
    column-gap: var(--spacing-lg);
  }

  .journal__grid > :global(*) {
    margin-block-end: var(--spacing-lg);
  }

  @media (min-width: 64rem) {
    .journal__grid {
      column-count: 2;
    }
  }

  @media (min-width: 80rem) {
    .journal__grid {
      column-count: 3;
    }
  }
</style>
