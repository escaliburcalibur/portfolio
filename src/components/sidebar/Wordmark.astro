---
import { site } from '@lib/site';

interface Props {
  /** When true, renders as a plain span (for use inside another link). */
  asText?: boolean;
}
const { asText = false } = Astro.props;
const Tag = asText ? 'span' : 'a';
const attrs = asText
  ? {}
  : { href: '/', 'aria-label': `${site.wordmark} — home` };
---

<Tag class="wordmark" data-text-fx {...attrs}>{site.wordmark}</Tag>

<style>
  .wordmark {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    color: var(--color-content);
  }
</style>
