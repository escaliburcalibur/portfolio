---
import { withBase } from '@lib/url';

interface Props {
  /** Renderiza un <span> en vez de un enlace (p. ej. dentro de otro <a>). */
  asText?: boolean;
}
const { asText = false } = Astro.props;
const label = 'David Bayón';
---

{
  asText ? (
    <span class="wordmark">{label}</span>
  ) : (
    <a
      class="wordmark"
      href={withBase('/')}
      data-fx
      aria-label={`${label} — inicio`}
    >
      {label}
    </a>
  )
}

<style>
  .wordmark {
    display: inline-block;
    font-size: var(--text-display);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    line-height: 1;
  }
</style>
