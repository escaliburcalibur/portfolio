---
import Wordmark from '@components/sidebar/Wordmark.astro';
import { withBase } from '@lib/url';

// Milestone 1: sidebar mínima (wordmark + enlaces básicos).
// El ProjectRail, ThemeToggle, GalleryToggle y el overlay móvil llegan en M2.
const nav = [
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/diario', label: 'Diario' },
];
---

<header class="sidebar" data-sidebar>
  <div class="sidebar__inner">
    <Wordmark />
    <nav class="sidebar__nav" aria-label="Principal">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a class="btn-text" href={withBase(item.href)} data-fx>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .sidebar {
    flex: 0 0 auto;
    border-block-end: 1px solid var(--color-line);
  }

  .sidebar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--pd) var(--space-md);
    padding: var(--gutter);
  }

  .sidebar__nav ul {
    display: flex;
    gap: var(--space-md);
  }

  @media (width >= 41rem) {
    .sidebar {
      position: sticky;
      inset-block-start: 0;
      inline-size: var(--rail);
      block-size: 100svh;
      overflow-y: auto;
      border-block-end: 0;
      border-inline-end: 1px solid var(--color-line);
    }

    .sidebar__inner {
      flex-direction: column;
      block-size: 100%;
    }

    .sidebar__nav ul {
      flex-direction: column;
      gap: var(--space-2xs);
    }
  }
</style>
