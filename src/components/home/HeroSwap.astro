---
import Placeholder from '@components/Placeholder.astro';
import { getProjects } from '@lib/content';

const projects = await getProjects();
---

<section class="hero" data-hero aria-label="Proyectos destacados">
  <div class="hero__stage">
    {
      projects.map((p, i) => (
        <figure
          class="hero__layer"
          data-hero-layer
          data-slug={p.id}
          data-selected={i === 0 ? 'true' : 'false'}
        >
          <Placeholder ratio="1496 / 998" label={p.data.title} />
        </figure>
      ))
    }
  </div>
  <figcaption class="hero__caption" data-hero-caption>
    <span class="hero__title" data-fx>{projects[0]?.data.title}</span>
    <span class="hero__desc">{projects[0]?.data.railDescription}</span>
  </figcaption>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--pd-2);
  }
  .hero__stage {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 1496 / 998;
    border-radius: var(--br-2);
    overflow: hidden;
  }
  .hero__layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur) var(--ease),
      visibility var(--dur) var(--ease);
  }
  .hero__layer[data-selected='true'] {
    opacity: 1;
    visibility: visible;
  }
  .hero__caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    font-size: var(--text-small);
  }
  .hero__title {
    font-weight: var(--weight-medium);
  }
  .hero__desc {
    color: var(--color-fg-50);
  }
</style>

<script>
  const GALLERY_INTERVAL = 2400;
  let timer: number | undefined;
  let bound = false;

  function selectFor(hero: HTMLElement, slug: string) {
    hero
      .querySelectorAll<HTMLElement>('[data-hero-layer]')
      .forEach((l) =>
        l.setAttribute('data-selected', String(l.dataset.slug === slug)),
      );
    const card = document.querySelector<HTMLElement>(
      `[data-rail-card][data-slug="${slug}"], [data-work-card][data-slug="${slug}"]`,
    );
    const caption = hero.querySelector<HTMLElement>('[data-hero-caption]');
    if (!caption || !card) return;
    const title = caption.querySelector('.hero__title');
    const desc = caption.querySelector('.hero__desc');
    const src = card.querySelector('.rail-card__title, .work-card__title');
    const dsc = card.querySelector('.rail-card__desc, .work-card__meta');
    if (title && src) title.textContent = src.textContent;
    if (desc && dsc) desc.textContent = dsc.textContent;
  }

  function stopGallery() {
    if (timer) window.clearInterval(timer);
    timer = undefined;
  }

  function startGallery() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    stopGallery();
    let idx = 0;
    timer = window.setInterval(() => {
      const hero = document.querySelector<HTMLElement>('[data-hero]');
      const layers = hero
        ? [...hero.querySelectorAll<HTMLElement>('[data-hero-layer]')]
        : [];
      if (!hero || !layers.length) return stopGallery();
      idx = (idx + 1) % layers.length;
      selectFor(hero, layers[idx].dataset.slug ?? '');
    }, GALLERY_INTERVAL);
  }

  function initHero() {
    stopGallery();
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;

    // Listeners sobre elementos persistentes (rail, window, document): una vez.
    if (!bound) {
      bound = true;
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.addEventListener('pointerover', (e) => {
          const t = e.target;
          if (!(t instanceof Element)) return;
          const card = t.closest<HTMLElement>('[data-rail-card]');
          const active = document.querySelector<HTMLElement>('[data-hero]');
          if (card?.dataset.slug && active)
            selectFor(active, card.dataset.slug);
        });
      }
      window.addEventListener('gallery-toggle', (e) => {
        if ((e as CustomEvent<{ on: boolean }>).detail.on) startGallery();
        else stopGallery();
      });
      document.addEventListener('astro:before-swap', stopGallery);
    }
  }

  document.addEventListener('astro:page-load', initHero);
</script>
