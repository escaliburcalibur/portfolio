---
import Placeholder from '@components/Placeholder.astro';
import type { JournalPost } from '@lib/content';

interface Props {
  entry: JournalPost;
  withMedia?: boolean;
}
const { entry, withMedia = false } = Astro.props;
const iso = entry.data.date.toISOString().slice(0, 10);
const date = entry.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class="update">
  <p class="update__date"><time datetime={iso}>{date}</time></p>
  <h2 class="update__title">
    <a href={`/journal/${entry.id}`} data-text-fx>{entry.data.title}</a>
  </h2>
  <p class="update__excerpt">{entry.data.excerpt}</p>
  {withMedia && <Placeholder label="" ratio="4 / 3" class="update__media" />}
</article>

<style>
  .update {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xs);
    break-inside: avoid;
  }

  .update__date {
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-content-faint);
  }

  .update__title {
    font-size: var(--text-display);
  }

  .update__title a:hover {
    color: var(--color-content-muted);
  }

  .update__excerpt {
    font-size: var(--text-small);
    color: var(--color-content-muted);
  }

  .update :global(.update__media) {
    margin-block-start: var(--spacing-2xs);
  }
</style>
