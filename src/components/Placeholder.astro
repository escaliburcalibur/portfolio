---
/**
 * Monochrome placeholder "media" block — stands in for images/video until
 * real assets land. Keeps the layout honest (aspect ratio, radius, border).
 */
interface Props {
  label?: string;
  /** CSS aspect-ratio value, e.g. "3 / 2". */
  ratio?: string;
  index?: number;
  class?: string;
}

const {
  label = 'Placeholder',
  ratio = '3 / 2',
  index,
  class: klass,
} = Astro.props;
const suffix = index != null ? ` ${String(index).padStart(2, '0')}` : '';
---

<div class:list={['ph', klass]} style={`--ph-ratio:${ratio}`}>
  <span class="ph__label">{label}{suffix}</span>
</div>

<style>
  .ph {
    aspect-ratio: var(--ph-ratio);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
  }

  .ph__label {
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-content-faint);
  }
</style>
