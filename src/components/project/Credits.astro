---
interface CreditGroup {
  org: string;
  lines: { role: string; name: string }[];
}
interface Props {
  credits: CreditGroup[];
}
const { credits } = Astro.props;
---

<div class="credits">
  <h3 class="credits__title">Credits</h3>
  {
    credits.map((group) => (
      <div class="credits__group">
        <p class="credits__org">{group.org}</p>
        <dl class="credits__lines">
          {group.lines.map((line) => (
            <div class="credits__line">
              <dt>{line.role}</dt>
              <dd>{line.name}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))
  }
</div>

<style>
  .credits__title {
    font-size: var(--text-display);
    color: var(--color-content-muted);
    margin-block-end: var(--spacing-sm);
  }

  .credits__group + .credits__group {
    margin-block-start: var(--spacing-sm);
  }

  .credits__org {
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-content-faint);
    margin-block-end: var(--spacing-3xs);
  }

  .credits__lines {
    margin: 0;
  }

  .credits__line {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-2xs);
  }

  .credits__line dt {
    color: var(--color-content-faint);
  }

  .credits__line dd {
    margin: 0;
    color: var(--color-content);
  }
</style>
