---
import Credits from '@components/project/Credits.astro';
import type { Project } from '@lib/content';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { credits, fonts, imagesDownloadUrl } = project.data;
---

<section class="project-info" aria-label="Project information" data-reveal>
  <div class="project-info__left">
    <h2 class="project-info__heading">Project information</h2>
    <div class="project-info__body">
      <slot />
    </div>
  </div>

  <div class="project-info__right">
    {credits.length > 0 && <Credits credits={credits} />}

    {
      fonts.length > 0 && (
        <div class="project-info__group">
          <h3 class="project-info__group-title">Fonts</h3>
          <ul>
            {fonts.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </div>
      )
    }

    {
      imagesDownloadUrl && (
        <a class="project-info__download" href={imagesDownloadUrl}>
          Download project images
        </a>
      )
    }
  </div>
</section>

<style>
  .project-info {
    display: grid;
    gap: var(--spacing-lg);
    padding-block-start: var(--spacing-xl);
    border-block-start: 1px solid var(--color-line);
  }

  .project-info__heading,
  .project-info__group-title {
    font-size: var(--text-display);
    color: var(--color-content-muted);
    margin-block-end: var(--spacing-sm);
  }

  .project-info__body {
    font-size: var(--text-body);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .project-info__right {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    font-size: var(--text-small);
    color: var(--color-content-muted);
  }

  .project-info__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-info__download {
    align-self: start;
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-content);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 2px;
  }

  @media (min-width: 57rem) {
    .project-info {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--spacing-2xl);
    }
  }
</style>
