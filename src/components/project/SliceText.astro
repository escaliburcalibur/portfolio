---
interface Props {
  heading?: string;
  body: string;
  variant?: 'default' | 'two-col' | 'featured';
}
const { heading, body, variant = 'default' } = Astro.props;
---

<div class="slice-text" data-variant={variant}>
  {heading && <h2 class="slice-text__heading">{heading}</h2>}
  <p class="slice-text__body">{body}</p>
</div>

<style>
  .slice-text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xs);
    inline-size: min(100%, 52ch);
    margin-inline: auto;
    padding-block: var(--spacing-md);
  }

  .slice-text[data-variant='featured'] {
    inline-size: min(100%, 62ch);
    min-block-size: 60svh;
    justify-content: center;
    padding-block: var(--spacing-xl);
  }

  .slice-text[data-variant='two-col'] {
    inline-size: min(100%, 78ch);
  }

  .slice-text__heading {
    font-size: var(--text-display);
    color: var(--color-content-muted);
  }

  .slice-text__body {
    font-size: var(--text-body);
    max-width: none;
  }

  @media (min-width: 48rem) {
    .slice-text[data-variant='two-col'] .slice-text__body {
      columns: 2;
      column-gap: var(--spacing-lg);
    }
  }
</style>
