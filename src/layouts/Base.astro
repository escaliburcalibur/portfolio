---
import { ClientRouter } from 'astro:transitions';
import Meta from '@layouts/Meta.astro';
import { SITE, type PageSeo } from '@lib/seo';
import '@styles/global.css';
import '@fontsource-variable/inter';

type Props = PageSeo;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Meta {...Astro.props} />
    <ClientRouter />
    {/* Tema sin parpadeo: aplica localStorage antes de pintar. */}
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.dataset.theme = t;
          }
        } catch {
          /* localStorage bloqueado — se usa prefers-color-scheme */
        }
        const m = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (!m.matches) {
          document.documentElement.classList.add('reveal-armed');
          // failsafe: si el JS de motion no arranca, revela todo a los 4s
          setTimeout(
            () => document.documentElement.classList.remove('reveal-armed'),
            4000,
          );
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <slot />
    <script>
      import '@lib/motion';
    </script>
  </body>
</html>
