---
import Meta from '@layouts/Meta.astro';
import type { PageSeo } from '@lib/seo';
import { SITE } from '@lib/seo';
import '@styles/global.css';

type Props = PageSeo;

const seo = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <Meta {...seo} />
    <!-- Set the theme before paint to avoid a flash. -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* private mode / blocked storage — fall back to the media query */
        }
        // Arm the load-in reveal (hides its targets); the motion module or this
        // failsafe removes it so text never stays hidden.
        const d = document.documentElement;
        d.classList.add('reveal-armed');
        setTimeout(() => d.classList.remove('reveal-armed'), 4000);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import '@lib/motion';
    </script>
  </body>
</html>
