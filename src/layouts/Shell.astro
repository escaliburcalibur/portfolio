---
import { fade } from 'astro:transitions';
import Base from '@layouts/Base.astro';
import Sidebar from '@components/sidebar/Sidebar.astro';
import type { PageSeo } from '@lib/seo';

type Props = PageSeo;
---

<Base {...Astro.props}>
  <div class="shell">
    <div class="shell__rail" transition:persist="sidebar">
      <Sidebar />
    </div>
    <div class="shell__content" transition:animate={fade({ duration: '0.5s' })}>
      <main id="main" class="page-container">
        <slot />
      </main>
    </div>
  </div>
</Base>
