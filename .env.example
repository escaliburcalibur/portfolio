# Copia a .env y rellena valores reales. .env está en .gitignore — nunca subas claves.

# URL pública del sitio. En local no hace falta.
# Producción (GitHub Pages, sitio de proyecto): https://escaliburcalibur.github.io
SITE_URL=

# Si algún día se usa un dominio propio, además de SITE_URL pon:
#   SITE_BASE=/
SITE_BASE=

# Endpoint de Formspree para el formulario de contacto (no es secreto, va en el HTML).
# Se puede fijar también en src/content/settings/site.json.
PUBLIC_FORMSPREE_ID=
